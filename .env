# ============================================================
# APP
# ============================================================
APP_NAME=KICS IT Help Desk
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================================
# DATABASE — MySQL (XAMPP)
# ============================================================
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=kics_ticketing

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=False

# ============================================================
# REDIS (optional)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# EMAIL — KICS Production (pacistv.rw)
# ============================================================
MAIL_USERNAME=kics@pacistv.rw
MAIL_PASSWORD=RwaPaC@2024!
MAIL_FROM=kics@pacistv.rw
MAIL_FROM_NAME=KICS IT Help Desk
MAIL_SERVER=mail.pacistv.rw
MAIL_PORT=465
MAIL_STARTTLS=False
MAIL_SSL_TLS=True
MAIL_USE_CREDENTIALS=True

# ============================================================
# IMAP — for email-to-ticket
# ============================================================
IMAP_SERVER=mail.pacistv.rw
IMAP_PORT=993
IMAP_EMAIL=kics@pacistv.rw
IMAP_PASSWORD=RwaPaC@2024!
IMAP_USE_SSL=True

# ============================================================
# FRONTEND
# ============================================================
FRONTEND_URL=http://localhost:5173

# ============================================================
# TOKEN EXPIRY (minutes)
# ============================================================
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
